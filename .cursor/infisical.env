# Non-secret Infisical coordinates for congress-trading-shared (shared-at-ct).
# Committed so install and start can both target the same project without
# hard-coding IDs in shell scripts.  Never put credentials here.
INFISICAL_PROJECT_ID=18f563a3-9c88-454c-96eb-28fc9678f3ba
# prod is the only Infisical environment (dev and staging retired 2026-10-10).
# scripts/cursor-cloud-start.sh refuses to fetch with any other value.
INFISICAL_ENV=prod
INFISICAL_DOMAIN=https://app.infisical.com